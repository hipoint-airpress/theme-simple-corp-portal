# 统一以 LF 存库、LF 检出，避免 Windows 编辑器写入 CRLF 造成整文件 diff
* text=auto eol=lf

# 二进制资源不做行尾转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.avif  binary
*.bmp   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.eot   binary
*.zip   binary
*.gz    binary
*.pdf   binary

# 主题相关文本类型
*.tmpl  text eol=lf
*.ts    text eol=lf
*.js    text eol=lf
*.cjs   text eol=lf
*.mjs   text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.svg   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
