<!DOCTYPE html>
    <html lang="zh-CN">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width,initial-scale=1">
        <title>{{ blog_title }} - {{ post.Title }}</title>
        <meta name="author" content="{{ user.Nickname }}">
        <meta name="keywords" content="{{ meta_keywords }}">
        <meta name="description" content="{{ meta_description }}">
        <link rel="alternate" type="application/rss+xml" title="atom 1.0" href="{{ atom_url }}">
        {% include "common/macro/head" %}
        {% include "simple_corp_portal/module/styles" %}
    </head>
    <body>
    {% include "simple_corp_portal/module/page-top" %}
    <main class="container">
        <section class="section">
            <div class="post-head">
                <h1>{{ post.Title }}</h1>
                <div class="post-meta">
                    <span><i>🗓</i>{{ unix_milli_time_format("2006-01-02", post.CreateTime) }}</span>
                    <span><i>👁</i>{{ post.Visits }}</span>
                    <span><i>💬</i><a href="{{ post.FullPath }}#comment_widget">{{ post.CommentCount }}</a></span>
                    <span><i>♥</i>{{ post.Likes }}</span>
                    {% if post.Categories %}
                        <span><i>📁</i>
                            {% for category in post.Categories %}
                                {% if not forloop.First %}, {% endif %}<a href="{{ category.FullPath }}">{{ category.Name }}</a>
                            {% endfor %}
                        </span>
                    {% endif %}
                    {% if post.Tags %}
                        <span><i>🏷</i>
                            {% for tag in post.Tags %}
                                {% if not forloop.First %}, {% endif %}<a href="{{ tag.FullPath }}">{{ tag.Name }}</a>
                            {% endfor %}
                        </span>
                    {% endif %}
                </div>
            </div>
            <div class="post-body">
                <div class="markdown-body">{{ post.Content|safe }}</div>
                <div id="comment_widget">
                    {% include "common/macro/comment" %}
                </div>
                <div class="post-nav">
                    {% if prevPost %}<a href="{{ prevPost.FullPath }}">‹ {{ prevPost.Title }}</a>{% else %}<span></span>{% endif %}
                    {% if nextPost %}<a href="{{ nextPost.FullPath }}">{{ nextPost.Title }} ›</a>{% else %}<span></span>{% endif %}
                </div>
            </div>
        </section>
        {% include "simple_corp_portal/module/footer" %}
    </main>
    </body>
    </html>