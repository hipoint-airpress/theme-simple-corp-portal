{% for post in posts.Content %}
        <div class="post-item">
            <div class="post-title">
                <a href="{{ post.FullPath }}">{{ post.Title }}</a>
            </div>
            {% if post.Summary %}
                <div class="post-summary">{{ post.Summary }}</div>
            {% endif %}
            <div class="post-meta">
                <span><i>🗓</i>{{ unix_milli_time_format("2006-01-02", post.CreateTime) }}</span>
                <span><i>👁</i>{{ post.Visits }}</span>
                <span><i>💬</i>{{ post.CommentCount }}</span>
                <span><i>♥</i>{{ post.Likes }}</span>
                {% if post.Categories %}
                    <span><i>📁</i>
                        {% for category in post.Categories %}
                            {% if forloop.Counter > 1 %}, {% endif %}<a href="{{ category.FullPath }}">{{ category.Name }}</a>
                        {% endfor %}
                    </span>
                {% endif %}
                {% if post.Tags %}
                    <span><i>🏷</i>
                        {% for tag in post.Tags %}
                            {% if forloop.Counter > 1 %}, {% endif %}<a href="{{ tag.FullPath }}">{{ tag.Name }}</a>
                        {% endfor %}
                    </span>
                {% endif %}
            </div>
        </div>
    {% endfor %}
