{%- set news = getCategoryBySlug(settings.news_category_slug|default:"news") -%}
    <section class="section">
        <div class="section-head">
            <span class="ico">📣</span>
            <h2>最新公告</h2>
            {% if news %}<a class="more" href="{{ news.FullPath }}">查看更多 ›</a>{% endif %}
        </div>
        <div class="notice">
            {% if news %}
                {% set posts = listPostByCategoryID(news.ID) %}
                {% if posts %}
                    {% for post in posts|slice:":3" %}
                        <div class="notice-row">
                            <span class="tag blue">{% if post.Tags %}{{ post.Tags.0.Name }}{% else %}公告{% endif %}</span>
                            <strong><a href="{{ post.FullPath }}" title="{{ post.Title }}">{{ post.Title }}</a></strong>
                            <span class="desc">{{ post.Summary }}</span>
                            <span class="date">{{ unix_milli_time_format("2006-01-02", post.CreateTime) }}</span>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="empty">暂无公告</div>
                {% endif %}
            {% else %}
                <div class="empty">暂无公告</div>
            {% endif %}
        </div>
    </section>
